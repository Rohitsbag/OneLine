# Supabase Configuration (Required for client and Vercel serverless proxy)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Vercel Serverless Function AI Proxy (Stored in Vercel Project Environment Variables)
GEMINI_API_KEY=your_google_gemini_api_key
ALLOWED_ORIGIN=https://get-one-line.vercel.app
