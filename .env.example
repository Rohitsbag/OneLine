# Supabase Configuration (Required for client and Vercel serverless proxy)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Gemini API Key (for Voice STT, Prompts, Weekly Summaries)
GEMINI_API_KEY=your_google_gemini_api_key
VITE_GEMINI_API_KEY=your_google_gemini_api_key
ALLOWED_ORIGIN=https://get-one-line.vercel.app

# Meta WhatsApp Cloud API Configuration (for WhatsApp Journaling Bot)
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret
VITE_WHATSAPP_BOT_NUMBER=your_meta_bot_phone_number_without_plus

# Daily Reminder Cron Secret
CRON_SECRET=your_random_cron_secret_token
